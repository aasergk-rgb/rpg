{
  "name": "titan-graft",
  "version": "0.1.0",
  "private": true,
  "description": "TITAN GRAFT - 部位奪取・3Dダークファンタジー・アクションRPG (Android)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
